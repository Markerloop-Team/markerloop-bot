{
    "swagger": "2.0",
    "info": {
        "description": "Сервис Telegram бота Markerloop (webhook, уведомления, OAuth)",
        "title": "Telegram Bot Service API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/notifications/broadcast": {
            "post": {
                "security": [
                    {
                        "ServiceKey": []
                    }
                ],
                "description": "Отправляет Telegram уведомление всем пользователям. Service-to-service endpoint.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "telegram"
                ],
                "summary": "Рассылка уведомлений",
                "parameters": [
                    {
                        "description": "Данные рассылки",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.SendBroadcastRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.GenericSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponseSwagger"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponseSwagger"
                        }
                    }
                }
            }
        },
        "/notifications/send": {
            "post": {
                "security": [
                    {
                        "ServiceKey": []
                    }
                ],
                "description": "Отправляет Telegram уведомление пользователю. Service-to-service endpoint.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "telegram"
                ],
                "summary": "Отправить уведомление",
                "parameters": [
                    {
                        "description": "Данные уведомления",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.SendNotificationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.GenericSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponseSwagger"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponseSwagger"
                        }
                    }
                }
            }
        },
        "/oauth/generate-token": {
            "post": {
                "security": [
                    {
                        "ServiceKey": []
                    }
                ],
                "description": "Генерирует deep link для привязки Telegram аккаунта. Service-to-service endpoint.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "telegram"
                ],
                "summary": "Генерация OAuth deep link",
                "parameters": [
                    {
                        "description": "ID пользователя",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.GenerateOAuthTokenRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.GenericSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponseSwagger"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponseSwagger"
                        }
                    }
                }
            }
        },
        "/webhook/telegram": {
            "post": {
                "description": "Принимает обновления от Telegram Bot API.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "telegram"
                ],
                "summary": "Telegram Webhook",
                "parameters": [
                    {
                        "type": "string",
                        "description": "secret_token, заданный при setWebhook (обязателен, если задан TELEGRAM_WEBHOOK_SECRET)",
                        "name": "X-Telegram-Bot-Api-Secret-Token",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Telegram Update объект",
                        "name": "update",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.GenericSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponseSwagger"
                        }
                    },
                    "401": {
                        "description": "secret token отсутствует или не совпадает (без тела)"
                    }
                }
            }
        }
    },
    "definitions": {
        "models.ErrorResponseSwagger": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "bad_request"
                },
                "message": {
                    "type": "string",
                    "example": "Ошибка"
                },
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "models.GenerateOAuthTokenRequest": {
            "type": "object",
            "required": [
                "user_id"
            ],
            "properties": {
                "user_id": {
                    "type": "string"
                }
            }
        },
        "models.GenericSuccessResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "models.SendBroadcastRequest": {
            "type": "object",
            "required": [
                "message",
                "title"
            ],
            "properties": {
                "message": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "models.SendNotificationRequest": {
            "type": "object",
            "required": [
                "message",
                "title",
                "user_id"
            ],
            "properties": {
                "message": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "user_id": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "ServiceKey": {
            "description": "Ключ для service-to-service аутентификации",
            "type": "apiKey",
            "name": "X-Service-Key",
            "in": "header"
        }
    }
}