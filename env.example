# Сервер
PORT=8085
HOST=0.0.0.0
LOG_LEVEL=info

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# Webhook Configuration
# Для production через gateway: https://your-domain.com/api/v1/telegram/webhook
# Для локальной разработки: оставьте пустым и используйте TELEGRAM_USE_POLLING=true
# ВАЖНО: URL должен указывать на gateway, а не напрямую на telegram-bot-service!
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook

# Secret Token для защиты webhook (Telegram будет отправлять этот токен в заголовке X-Telegram-Bot-Api-Secret-Token)
# Генерируйте случайную строку (минимум 32 символа) для production
# Пример: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here_min_32_chars

# Polling Mode (только для локальной разработки)
# Установите в true для использования polling вместо webhook
# ВНИМАНИЕ: Не используйте в production!
TELEGRAM_USE_POLLING=false

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=1

# Внешние сервисы
GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083
DICTIONARY_SERVICE_URL=http://localhost:8084

# Service Key для внутренних вызовов
SERVICE_KEY=your_service_key_here

# OAuth Configuration
OAUTH_TOKEN_TTL=10m

# HTTP Client Configuration
HTTP_CLIENT_TIMEOUT=10s

# SDL-345: окно подавления повторной доставки уведомления с тем же
# Idempotency-Key (ретраи notification-service, EP-56)
NOTIFY_IDEMPOTENCY_TTL=1h
